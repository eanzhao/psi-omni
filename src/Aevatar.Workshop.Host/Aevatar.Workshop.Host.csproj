<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(DefaultTargetFramework)</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableSKExperimentalFeatures>true</EnableSKExperimentalFeatures>
        <NoWarn>$(NoWarn);SKEXP0050</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aevatar"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Console"/>
        <PackageReference Include="Microsoft.Orleans.Server"/>
        <PackageReference Include="Orleans.Providers.MongoDB"/>
        <PackageReference Include="Volo.Abp.AspNetCore.Serilog"/>
        <PackageReference Include="Volo.Abp.Autofac"/>
        <PackageReference Include="Volo.Abp.AutoMapper"/>
        <PackageReference Include="Serilog.AspNetCore"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="Serilog.Sinks.OpenTelemetry"/>
        <PackageReference Include="Microsoft.SemanticKernel.Plugins.Web"/>
        <PackageReference Include="OrleansDashboard"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.secrets.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PsiGAgent.Omni\PsiGAgent.Omni.csproj" />
        <ProjectReference Include="..\PsiOrleans.Plugins\PsiOrleans.Plugins.csproj"/>
        
    </ItemGroup>

</Project>
